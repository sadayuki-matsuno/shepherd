module CGtkLayerShell [system] {
    header "shim.h"
    // gtk4-layer-shell-0.pc only lists gtk4 under Requires.private, so its
    // Libs line carries no -lgtk-4; declare the GTK/GLib link deps here.
    link "gtk4-layer-shell"
    link "gtk-4"
    link "gobject-2.0"
    link "gio-2.0"
    link "glib-2.0"
    export *
}
